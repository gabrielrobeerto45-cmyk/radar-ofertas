# Copie para .env e preencha. NUNCA publique o seu .env.

# Senha do banco (invente uma longa): openssl rand -hex 24
POSTGRES_PASSWORD=

# 1 = só mostra no log o que postaria (teste) | 0 = posta de verdade
DRY_RUN=1

# Telegram: crie o bot no @BotFather e adicione-o como admin do canal
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=          # @seucanal ou -100xxxxxxxxxx
CHANNEL_USERNAME=          # seucanal (sem @), usado no botão do site

# Shopee Afiliados -> Open API
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Mercado Livre: app em developers.mercadolivre.com.br (Client Credentials)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Do seu link de afiliado do ML (abra um meli.la e copie matt_word / matt_tool)
ML_MATT_WORD=
ML_MATT_TOOL=

# O que monitorar (separe por ;). Vazio = modo demonstração com produtos falsos
SEARCHES=shopee:fone bluetooth; shopee:air fryer; ml:fone bluetooth; ml:air fryer

# Ajustes (opcionais)
CYCLE_MINUTES=10
MAX_POSTS_PER_HOUR=6
QUIET_HOURS=0-7
DROP_PCT=20
MIN_HISTORY_DAYS=2

# Site público (opcional). Com domínio apontado para a VPS, o HTTPS é automático.
SITE_NAME=Radar de Ofertas
SITE_ADDRESS=:80
SITE_URL=
